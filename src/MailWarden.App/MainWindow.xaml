<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MailWarden.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MailWarden.App"
    xmlns:presentation="using:MailWarden.Presentation"
    Title="MailWarden">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar: actions on the selection, layout toggle, refresh, theme, settings, failed actions; the search on the right. -->
    <Grid Grid.Row="0" Margin="8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ScrollViewer
          Grid.Column="0"
          HorizontalScrollBarVisibility="Auto"
          HorizontalScrollMode="Auto"
          VerticalScrollBarVisibility="Disabled"
          VerticalScrollMode="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="MarkReadButton" Command="{x:Bind ViewModel.MarkReadCommand}" />
          <Button x:Name="MarkUnreadButton" Command="{x:Bind ViewModel.MarkUnreadCommand}" />
          <Button x:Name="ToggleFlagButton" Command="{x:Bind ViewModel.ToggleFlagCommand}" />
          <Button x:Name="DeleteButton" Command="{x:Bind ViewModel.DeleteCommand}" />
          <DropDownButton x:Name="MoveButton" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}">
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="MoveToolbarMenu" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button
              x:Name="EmptyFolderButton"
              Command="{x:Bind ViewModel.EmptyFolderCommand}"
              Visibility="{x:Bind ViewModel.CanEmptyFolder, Mode=OneWay}" />
          <Button x:Name="ToggleLayoutButton" Command="{x:Bind ViewModel.ToggleLayoutCommand}" />
          <Button x:Name="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" />
          <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="ThemeChoice" SelectionChanged="OnThemeChoiceChanged" />
          <Button x:Name="SettingsButton">
            <Button.Flyout>
              <Flyout>
                <ToggleSwitch x:Name="MarkReadOnSelectSwitch" IsOn="{x:Bind ViewModel.MarkReadOnSelect, Mode=TwoWay}" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="FailedActionsButton" Visibility="{x:Bind ViewModel.HasFailedActions, Mode=OneWay}">
            <Button.Flyout>
              <Flyout>
                <ItemsControl ItemsSource="{x:Bind ViewModel.FailedActions, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:PendingActionRow">
                      <Grid Margin="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind Text}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Click="OnDiscardFailedActionClicked" Content="{x:Bind presentation:UiText.DiscardFailedAction}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <AutoSuggestBox
          x:Name="SearchBox"
          Grid.Column="1"
          Width="240"
          VerticalAlignment="Center"
          QueryIcon="Find"
          QuerySubmitted="OnSearchSubmitted"
          TextChanged="OnSearchTextChanged" />
    </Grid>

    <!-- Set in code-behind: x:Bind function bindings are not called for null, so the bar would never close. -->
    <InfoBar x:Name="BannerBar" Grid.Row="1" IsClosable="False" Severity="Warning" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigationColumn" Width="280" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation: always on the left. -->
      <TreeView
          x:Name="NavigationTree"
          Grid.Column="0"
          ItemInvoked="OnNavigationItemInvoked"
          ItemsSource="{x:Bind ViewModel.Navigation.Items}"
          SelectionMode="Single">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="presentation:NavigationItem">
            <TreeViewItem ContextRequested="OnNavigationItemContextRequested" IsExpanded="True" ItemsSource="{x:Bind Children}">
              <!-- The right margin keeps the unread number out from under the scrollbar of the tree (16 px when expanded). -->
              <Grid Margin="0,0,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock
                      FontSize="{x:Bind local:XamlFormat.TreeLabelSize(IsAccountNode)}"
                      FontWeight="{x:Bind local:XamlFormat.TreeLabelWeight(IsAccountNode)}"
                      Text="{x:Bind Label}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      Style="{StaticResource CaptionTextBlockStyle}"
                      Opacity="0.7"
                      Text="{x:Bind StatusText, Mode=OneWay}"
                      TextTrimming="CharacterEllipsis"
                      Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{x:Bind local:XamlFormat.UnreadText(UnreadCount), Mode=OneWay}" />
              </Grid>
            </TreeViewItem>
          </DataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <local:PaneSplitter x:Name="NavigationSplitter" Grid.Column="1" />

      <!-- List and reading pane: columns or rows; the code-behind moves them without recreating the browser control. -->
      <Grid x:Name="MessagePanes" Grid.Column="2" SizeChanged="OnMessagePanesSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PaneColumnFirst" />
          <ColumnDefinition x:Name="PaneColumnSplitter" />
          <ColumnDefinition x:Name="PaneColumnLast" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PaneRowFirst" />
          <RowDefinition x:Name="PaneRowSplitter" />
          <RowDefinition x:Name="PaneRowLast" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="MessageList"
            ContextRequested="OnMessageListContextRequested"
            ItemsSource="{x:Bind ViewModel.Messages.Items}"
            KeyDown="OnMessageListKeyDown"
            Loaded="OnMessageListLoaded"
            SelectionChanged="OnMessageListSelectionChanged"
            SelectionMode="Extended">
          <ListView.ContextFlyout>
            <MenuFlyout>
              <MenuFlyoutItem x:Name="ContextMarkRead" Command="{x:Bind ViewModel.MarkReadCommand}" />
              <MenuFlyoutItem x:Name="ContextMarkUnread" Command="{x:Bind ViewModel.MarkUnreadCommand}" />
              <MenuFlyoutItem x:Name="ContextToggleFlag" Command="{x:Bind ViewModel.ToggleFlagCommand}" />
              <MenuFlyoutItem x:Name="ContextDelete" Command="{x:Bind ViewModel.DeleteCommand}" />
              <MenuFlyoutItem x:Name="ContextDeletePermanently" Command="{x:Bind ViewModel.DeletePermanentlyCommand}" />
              <MenuFlyoutSubItem x:Name="ContextMove" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
              <MenuFlyoutItem
                  x:Name="ContextEmptyFolder"
                  Command="{x:Bind ViewModel.EmptyFolderCommand}"
                  Visibility="{x:Bind ViewModel.CanEmptyFolder, Mode=OneWay}" />
            </MenuFlyout>
          </ListView.ContextFlyout>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="presentation:MessageRowViewModel">
              <Grid Margin="0,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock
                      FontWeight="{x:Bind local:XamlFormat.RowWeight(IsUnread), Mode=OneWay}"
                      Text="{x:Bind Sender}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      FontWeight="{x:Bind local:XamlFormat.RowWeight(IsUnread), Mode=OneWay}"
                      Text="{x:Bind Subject}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      Style="{StaticResource CaptionTextBlockStyle}"
                      Opacity="0.7"
                      Text="{x:Bind Preview}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock HorizontalAlignment="Right" Text="{x:Bind DateText}" />
                  <TextBlock
                      HorizontalAlignment="Right"
                      Style="{StaticResource CaptionTextBlockStyle}"
                      Opacity="0.7"
                      Text="{x:Bind AccountLabel}" />
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                    <FontIcon FontSize="12" Glyph="&#xE723;" Visibility="{x:Bind HasAttachments}" />
                    <FontIcon FontSize="12" Glyph="&#xE7C1;" Visibility="{x:Bind IsFlagged, Mode=OneWay}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <local:PaneSplitter x:Name="ListSplitter" />

        <Grid x:Name="ReadingPane" Margin="8,0,8,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header lines are limited in the view model; the height limit keeps the document reachable for long lists. -->
          <ScrollViewer Grid.Row="0" MaxHeight="160" Margin="0,0,0,4" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="2">
              <TextBlock
                  IsTextSelectionEnabled="True"
                  MaxLines="3"
                  Style="{StaticResource SubtitleTextBlockStyle}"
                  Text="{x:Bind ViewModel.Reading.Subject, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="Wrap" />
              <TextBlock
                  IsTextSelectionEnabled="True"
                  MaxLines="2"
                  Text="{x:Bind local:XamlFormat.FromLine(ViewModel.Reading.From), Mode=OneWay}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="Wrap"
                  Visibility="{x:Bind local:XamlFormat.VisibleWhenText(ViewModel.Reading.From), Mode=OneWay}" />
              <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind local:XamlFormat.ToLine(ViewModel.Reading.To), Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:XamlFormat.VisibleWhenText(ViewModel.Reading.To), Mode=OneWay}" />
              <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind local:XamlFormat.CcLine(ViewModel.Reading.Cc), Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:XamlFormat.VisibleWhenText(ViewModel.Reading.Cc), Mode=OneWay}" />
              <TextBlock Opacity="0.7" Text="{x:Bind local:XamlFormat.DateLine(ViewModel.Reading.DateText), Mode=OneWay}" Visibility="{x:Bind local:XamlFormat.VisibleWhenText(ViewModel.Reading.DateText), Mode=OneWay}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Attachments: the list virtualises, and its height limit keeps the document reachable for a mail with many of them. -->
          <StackPanel Grid.Row="1" Margin="0,0,0,8" Spacing="2" Visibility="{x:Bind ViewModel.Reading.HasAttachments, Mode=OneWay}">
            <TextBlock Text="{x:Bind presentation:UiText.AttachmentsLabel}" />
            <ListView
                MaxHeight="136"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Reading.Attachments, Mode=OneWay}"
                SelectionMode="None">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="MinHeight" Value="36" />
                  <Setter Property="Padding" Value="4,0" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="presentation:AttachmentRow">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Name}" />
                    <!-- Its own column, so a long name cannot push the extension Windows goes by out of sight; a long extension is cut here. -->
                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="96"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ExtensionText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ExtensionText}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind SizeText}" />
                    <Button
                        Grid.Column="3"
                        Click="OnOpenAttachmentClicked"
                        Content="{x:Bind presentation:UiText.AttachmentOpen}"
                        Visibility="{x:Bind CanOpen}" />
                    <Button
                        Grid.Column="4"
                        Click="OnSaveAttachmentClicked"
                        Content="{x:Bind presentation:UiText.AttachmentSave}"
                        Visibility="{x:Bind HasContent}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Opacity="0.7"
                Text="{x:Bind ViewModel.Reading.HiddenAttachmentsNotice, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Reading.HasHiddenAttachments, Mode=OneWay}" />
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Reading.AttachmentNotice, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Reading.HasAttachmentNotice, Mode=OneWay}" />
          </StackPanel>

          <Button
              Grid.Row="2"
              Margin="0,0,0,8"
              Command="{x:Bind ViewModel.Reading.LoadRemoteImagesCommand}"
              Content="{x:Bind local:XamlFormat.LoadImagesText(ViewModel.Reading.BlockedRemoteResourceCount), Mode=OneWay}"
              Visibility="{x:Bind ViewModel.Reading.CanLoadRemoteImages, Mode=OneWay}" />

          <TextBlock
              Grid.Row="3"
              Margin="0,0,0,8"
              FontWeight="SemiBold"
              Text="{x:Bind ViewModel.Reading.ContentNotice, Mode=OneWay}"
              TextWrapping="Wrap"
              Visibility="{x:Bind ViewModel.Reading.HasContentNotice, Mode=OneWay}" />

          <TextBlock
              x:Name="ReadingStatusText"
              Grid.Row="4"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextWrapping="Wrap" />
          <WebView2 x:Name="ReadingWebView" Grid.Row="4" Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Grid>

    <!-- Target of the link under the mouse; placed in code-behind, above everything, and never in the way of the mouse. -->
    <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
      <Border
          x:Name="LinkHint"
          Padding="8,4"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Visibility="Collapsed">
        <TextBlock x:Name="LinkHintText" TextWrapping="Wrap" />
      </Border>
    </Canvas>
  </Grid>
</Window>
