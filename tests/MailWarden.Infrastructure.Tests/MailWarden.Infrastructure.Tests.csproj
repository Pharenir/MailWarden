<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA2007 (ConfigureAwait) is irrelevant in test code: xUnit v2 runs tests without a synchronisation context. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MailWarden.Core\MailWarden.Core.csproj" />
    <ProjectReference Include="..\..\src\MailWarden.Infrastructure\MailWarden.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MailWarden.Core.Model" />
    <Using Include="MailWarden.Core.Storage" />
    <Using Include="MailWarden.Infrastructure.Storage" />
    <Using Include="MailWarden.Infrastructure.Tests.TestSupport" />
  </ItemGroup>

</Project>
