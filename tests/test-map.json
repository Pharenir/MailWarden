{
  "description": "Maps changed paths to test selections. Values are feature tags (xUnit trait Category=<tag without @>) or FULL (run S3).",
  "tagFormat": "Category=feature:<name>",
  "map": {
    "src/MailWarden.Infrastructure/Storage/Schema*": ["FULL"],
    "src/MailWarden.Infrastructure/Storage/**/*Migration*": ["FULL"],
    "src/MailWarden.Core/**/I*.cs": ["FULL"],
    "src/MailWarden.Core/Model/**": ["@feature:storage"],
    "src/MailWarden.Core/Storage/**": ["@feature:storage"],
    "src/MailWarden.Core/Classification/**": ["@feature:classifier"],
    "src/MailWarden.Infrastructure/Storage/**": ["@feature:storage"],
    "src/MailWarden.Infrastructure/Sync/SyncEngine*": ["FULL"],
    "src/MailWarden.Core/Sync/**": ["@feature:sync", "@feature:storage"],
    "src/MailWarden.Infrastructure/Sync/**": ["@feature:sync"],
    "src/MailWarden.Infrastructure/Mime/**": ["@feature:sync"],
    "tests/MailWarden.Infrastructure.Tests/Sync/**": ["@feature:sync"],
    "tests/MailWarden.Infrastructure.Tests/Mime/**": ["@feature:sync"],
    "src/MailWarden.Core/Accounts/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Security/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Auth/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Providers/**": ["@feature:accounts"],
    "tests/**/TestSupport/**": ["FULL"],
    "tests/fixtures/**": ["FULL"],
    "Directory.Build.props": ["FULL"],
    "*.csproj": ["FULL"],
    "*.runsettings": ["FULL"],
    "MailWarden.sln": ["FULL"],
    "src/MailWarden.App/**": []
  }
}
