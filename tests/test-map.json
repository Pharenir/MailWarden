{
  "description": "Maps changed paths to test selections. Values are feature tags (xUnit trait Category=<tag without @>) or FULL (run S3).",
  "tagFormat": "Category=feature:<name>",
  "map": {
    "src/MailWarden.Infrastructure/Storage/Schema*": ["FULL"],
    "src/MailWarden.Infrastructure/Storage/**/*Migration*": ["FULL"],
    "src/MailWarden.Core/**/I*.cs": ["FULL"],
    "src/MailWarden.Core/Model/**": ["@feature:storage"],
    "src/MailWarden.Core/Storage/**": ["@feature:storage"],
    "src/MailWarden.Core/Classification/**": ["@feature:classifier"],
    "src/MailWarden.Infrastructure/Classification/**": ["@feature:classifier"],
    "src/MailWarden.Infrastructure/Storage/SqliteClassificationLog*": ["@feature:classifier", "@feature:storage"],
    "src/MailWarden.Infrastructure/Storage/SqliteContactStore*": ["@feature:classifier", "@feature:storage"],
    "src/MailWarden.Infrastructure/Sync/MailKitFolderProvisioner*": ["@feature:sync", "@feature:classifier"],
    "src/MailWarden.Infrastructure/Storage/**": ["@feature:storage"],
    "src/MailWarden.Infrastructure/Sync/SyncEngine*": ["FULL"],
    "src/MailWarden.Core/Commands/**": ["@feature:sync", "@feature:storage"],
    "src/MailWarden.Infrastructure/Commands/**": ["@feature:sync", "@feature:storage"],
    "src/MailWarden.Core/Sync/**": ["@feature:sync", "@feature:storage"],
    "src/MailWarden.Infrastructure/Sync/**": ["@feature:sync"],
    "src/MailWarden.Infrastructure/Mime/**": ["@feature:sync", "@feature:ui"],
    "tests/MailWarden.Infrastructure.Tests/Sync/**": ["@feature:sync"],
    "tests/MailWarden.Infrastructure.Tests/Mime/**": ["@feature:sync", "@feature:ui"],
    "src/MailWarden.Infrastructure/Background/**": ["@feature:sync", "@feature:storage"],
    "tests/MailWarden.Infrastructure.Tests/Background/**": ["@feature:sync", "@feature:storage"],
    "src/MailWarden.Core/Accounts/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Security/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Auth/**": ["@feature:accounts"],
    "src/MailWarden.Infrastructure/Providers/**": ["@feature:accounts"],
    "tests/**/TestSupport/**": ["FULL"],
    "tests/fixtures/**": ["FULL"],
    "Directory.Build.props": ["FULL"],
    "*.csproj": ["FULL"],
    "*.runsettings": ["FULL"],
    "MailWarden.sln": ["FULL"],
    "src/MailWarden.Core/Text/**": ["@feature:ui"],
    "tests/MailWarden.Core.Tests/Text/**": ["@feature:ui"],
    "src/MailWarden.Infrastructure/Composition/MailboxActions*": ["@feature:ui", "@feature:sync", "@feature:storage"],
    "src/MailWarden.Infrastructure/Composition/**": ["@feature:ui", "@feature:storage", "@feature:sync", "@feature:classifier"],
    "tests/MailWarden.Infrastructure.Tests/Composition/**": ["@feature:ui", "@feature:storage", "@feature:sync", "@feature:classifier"],
    "src/MailWarden.Infrastructure/Logging/**": ["@feature:ui"],
    "tests/MailWarden.Infrastructure.Tests/Logging/**": ["@feature:ui"],
    "src/MailWarden.Presentation/**": ["@feature:ui"],
    "tests/MailWarden.Presentation.Tests/**": ["@feature:ui"],
    "src/MailWarden.App/**": ["@feature:ui"]
  }
}
