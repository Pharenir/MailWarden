# Optional overrides. Secrets (tokens, app passwords) are never stored here; they live DPAPI-encrypted in the data folder.
# Data folder (default: data\ next to MailWarden.App.exe; must be a fully qualified path)
MAILWARDEN_DATA_DIR=
# Microsoft Entra app registration (public client, no secret); see docs\auth-setup.md.
MAILWARDEN_MS_CLIENT_ID=
# Google Cloud OAuth desktop client; see docs\auth-setup.md. Alternatively <data folder>\auth-config.json.
MAILWARDEN_GOOGLE_CLIENT_ID=
MAILWARDEN_GOOGLE_CLIENT_SECRET=
